{{ define "_locations" -}}
    {{ range .APIs -}}
    {{ if .Enabled -}}
    {{ if .ForwardAuth -}}
    # auth-check upstream for {{ .Name }}
    location = /{{ .ForwardAuth.UpstreamName }} {
        internal;
        proxy_pass {{ .ForwardAuth.Upstream }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {{ end -}}
    {{ if .JWT -}}
    # JWT auth-check for {{ .Name }} → dashboard daemon
    location = /_apigw_jwt_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/jwt/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
    }
    {{ end -}}
    {{ if .MTLS -}}
    # mTLS auth-check for {{ .Name }} → dashboard daemon
    location = /_apigw_mtls_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/mtls/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Apigw-Mtls-Verify      $ssl_client_verify;
        proxy_set_header X-Apigw-Mtls-SDN         $ssl_client_s_dn;
        proxy_set_header X-Apigw-Mtls-Cert        $ssl_client_escaped_cert;
        proxy_set_header X-Apigw-Mtls-Fingerprint $ssl_client_fingerprint;
        proxy_set_header X-Original-URI $request_uri;
    }
    {{ end -}}
    {{ if .APIKey -}}
    # API key auth-check for {{ .Name }} → dashboard daemon
    location = /_apigw_apikey_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/apikey/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header X-Original-URI $request_uri;
    }
    {{ end -}}
    {{ if .Session -}}
    # Session-cookie auth-check for {{ .Name }} → dashboard daemon.
    # The dashboard reads the session cookie name from
    # Security.Sessions.CookieName (default apigw_session).
    location = /_apigw_session_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/session/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }
    {{ end -}}
    {{ if .HMAC -}}
    # HMAC signature auth-check for {{ .Name }} → dashboard daemon.
    # Body is NOT forwarded — integrity is enforced via signed
    # X-Apigw-Content-SHA256 header (computed by the client).
    location = /_apigw_hmac_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/hmac/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Apigw-Date $http_x_apigw_date;
        proxy_set_header X-Apigw-Nonce $http_x_apigw_nonce;
        proxy_set_header X-Apigw-Content-SHA256 $http_x_apigw_content_sha256;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI $request_uri;
    }
    {{ end -}}
    {{ if .OAuth2 -}}
    # OAuth2 introspection auth-check for {{ .Name }} → dashboard daemon
    location = /_apigw_oauth2_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/oauth2/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
    }
    {{ end -}}
    {{ if .Mirror -}}
    # Shadow-traffic mirror for {{ .Name }} → {{ .Mirror.UpstreamURL }}
    location = {{ .Mirror.Path }} {
        internal;
        proxy_pass {{ .Mirror.UpstreamURL }}$request_uri;
        {{ if .Mirror.IgnoreBody }}proxy_pass_request_body off;{{ end }}
        proxy_set_header Host $host;
        proxy_set_header X-Apigw-Mirrored-From $request_uri;
    }
    {{ end -}}
    {{ range .Versions -}}
    # version: {{ .Name }} ({{ .State }})
    location {{ .FullPath }} {
        {{ if eq .State "retired" -}}
        # retired — 410 Gone + successor-version Link header (RFC 8594).
        {{ if .ReplacementURL -}}
        add_header Link "<{{ .ReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        return 410 "version {{ .Name }} retired\n";
        {{ else -}}
        {{ if eq .State "deprecated" -}}
        # deprecated — RFC 8594 Sunset + Deprecation headers.
        add_header Deprecation "true" always;
        {{ if .SunsetAt -}}
        add_header Sunset "{{ .SunsetAt }}" always;
        {{ end -}}
        {{ if .ReplacementURL -}}
        add_header Link "<{{ .ReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        {{ end -}}
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Apigw-Version   "{{ .Name }}";
        proxy_pass http://{{ .Upstream }};
        {{ end -}}
    }
    {{ end -}}
    location {{ .Path }} {
        {{ if .LifecycleDraft -}}
        # lifecycle: draft — returns 503 until promoted to published.
        return 503 "draft API\n";
        {{ end -}}
        {{ if .LifecycleRetired -}}
        # lifecycle: retired — returns 410 Gone.
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        return 410 "retired API\n";
        {{ end -}}
        {{ if .LifecycleDeprecated -}}
        # lifecycle: deprecated — RFC 8594 Deprecation + Sunset headers.
        add_header Deprecation "true" always;
        {{ if .LifecycleSunsetAt -}}
        add_header Sunset "{{ .LifecycleSunsetAt }}" always;
        {{ end -}}
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        {{ end -}}
        {{ range .Rewrites -}}
        rewrite {{ .Match }} {{ .Replace }} {{ .Flag }};
        {{ end -}}
        {{ if .MaxBodySize }}client_max_body_size {{ .MaxBodySize }};
        {{ end -}}
        {{ range .Allow }}allow {{ . }};
        {{ end -}}
        {{ range .Deny }}deny {{ . }};
        {{ end -}}
        {{ if .Allow }}deny all;
        {{ end -}}
        {{ if .BasicAuthRealm -}}
        auth_basic "{{ .BasicAuthRealm }}";
        auth_basic_user_file {{ .BasicAuthFile }};
        {{ end -}}
        {{ if .ForwardAuth -}}
        auth_request /{{ .ForwardAuth.UpstreamName }};
        {{ range .ForwardAuth.SetHeaders -}}
        auth_request_set ${{ . }} $upstream_http_{{ . }};
        proxy_set_header {{ . }} ${{ . }};
        {{ end -}}
        {{ if .ForwardAuth.SignInURL -}}
        error_page 401 = @apigw_sign_in_{{ .Name }};
        {{ end -}}
        {{ end -}}
        {{ if .JWT -}}
        auth_request /_apigw_jwt_{{ .Name }};
        auth_request_set $apigw_subject $upstream_http_x_apigw_subject;
        proxy_set_header X-Remote-User $apigw_subject;
        {{ end -}}
        {{ if .MTLS -}}
        auth_request /_apigw_mtls_{{ .Name }};
        auth_request_set $apigw_client_cn $upstream_http_x_apigw_client_cn;
        proxy_set_header X-Client-CN $apigw_client_cn;
        {{ end -}}
        {{ if .APIKey -}}
        auth_request /_apigw_apikey_{{ .Name }};
        auth_request_set $apigw_apikey_id $upstream_http_x_apigw_apikey_id;
        auth_request_set $apigw_apikey_owner $upstream_http_x_apigw_apikey_owner;
        auth_request_set $apigw_apikey_scopes $upstream_http_x_apigw_apikey_scopes;
        proxy_set_header X-Apigw-ApiKey-ID $apigw_apikey_id;
        proxy_set_header X-Apigw-ApiKey-Owner $apigw_apikey_owner;
        proxy_set_header X-Apigw-ApiKey-Scopes $apigw_apikey_scopes;
        {{ end -}}
        {{ if or .APIKey .HMAC .Session .OAuth2 .JWT .MTLS -}}
        # Consumer headers — set by whichever auth handler ran.
        # Empty when the consumer isn't in the registry (resolution
        # is best-effort).
        auth_request_set $apigw_consumer_id $upstream_http_x_apigw_consumer_id;
        auth_request_set $apigw_consumer_groups $upstream_http_x_apigw_consumer_groups;
        proxy_set_header X-Apigw-Consumer-Id $apigw_consumer_id;
        proxy_set_header X-Apigw-Consumer-Groups $apigw_consumer_groups;
        {{ end -}}
        {{ if .Session -}}
        auth_request /_apigw_session_{{ .Name }};
        auth_request_set $apigw_session_sub $upstream_http_x_apigw_subject;
        auth_request_set $apigw_session_id $upstream_http_x_apigw_session_id;
        auth_request_set $apigw_session_scopes $upstream_http_x_apigw_scopes;
        proxy_set_header X-Apigw-Subject $apigw_session_sub;
        proxy_set_header X-Apigw-Session-ID $apigw_session_id;
        proxy_set_header X-Apigw-Scopes $apigw_session_scopes;
        {{ end -}}
        {{ if .HMAC -}}
        auth_request /_apigw_hmac_{{ .Name }};
        auth_request_set $apigw_hmac_id $upstream_http_x_apigw_hmac_key_id;
        auth_request_set $apigw_hmac_owner $upstream_http_x_apigw_hmac_owner;
        auth_request_set $apigw_hmac_scopes $upstream_http_x_apigw_hmac_scopes;
        proxy_set_header X-Apigw-HMAC-Key-ID $apigw_hmac_id;
        proxy_set_header X-Apigw-HMAC-Owner $apigw_hmac_owner;
        proxy_set_header X-Apigw-HMAC-Scopes $apigw_hmac_scopes;
        {{ end -}}
        {{ if .OAuth2 -}}
        auth_request /_apigw_oauth2_{{ .Name }};
        auth_request_set $apigw_subject $upstream_http_x_apigw_subject;
        auth_request_set $apigw_username $upstream_http_x_apigw_username;
        auth_request_set $apigw_scopes $upstream_http_x_apigw_scopes;
        proxy_set_header X-Remote-User $apigw_subject;
        proxy_set_header X-Apigw-Username $apigw_username;
        proxy_set_header X-Apigw-Scopes $apigw_scopes;
        {{ end -}}
        {{ if .BotGuard -}}
        {{ if .BotGuard.RequireUserAgent }}if ($http_user_agent = "") { return 403; }
        {{ end -}}
        {{ if .BotGuard.BlockEmptyReferer }}if ($http_referer = "") { return 403; }
        {{ end -}}
        {{ if .BotGuard.BlockCommonScanners }}if ($http_user_agent ~* "(nikto|nmap|masscan|zgrab|sqlmap|fuzz|curl/[0-7]|wget)") { return 403; }
        {{ end -}}
        {{ range .BotGuard.BlockedAgents }}if ($http_user_agent ~* "{{ . }}") { return 403; }
        {{ end -}}
        {{ if .BotGuard.UseIPReputation }}if ($apigw_ip_blocked = 1) { return 403; }
        {{ end -}}
        {{ if .BotGuard.HasTLSPatterns }}if ($apigw_tls_blocked_{{ .Name }} = 1) { return 403; }
        {{ end -}}
        {{ if .BotGuard.ForwardTLSFingerprint }}proxy_set_header X-Apigw-TLS-Profile "$ssl_protocol/$ssl_cipher/$ssl_curves/$ssl_ciphers";
        {{ end -}}
        {{ end -}}
        {{ if .Mirror -}}
        mirror {{ .Mirror.Path }};
        {{ if .Mirror.IgnoreBody }}mirror_request_body off;{{ end }}
        {{ end -}}
        {{ if .Cache -}}
        proxy_cache {{ .Cache.ZoneName }};
        proxy_cache_key "{{ .Cache.Key }}";
        proxy_cache_methods {{ range $i, $m := .Cache.Methods }}{{ if $i }} {{ end }}{{ $m }}{{ end }};
        proxy_cache_valid 200 301 302 {{ .Cache.Duration }};
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        {{ if .Cache.BypassHeader }}proxy_cache_bypass $http_{{ .Cache.BypassHeader }};
        proxy_no_cache $http_{{ .Cache.BypassHeader }};
        {{ end -}}
        {{ end -}}
        {{ if .Timeouts -}}
        {{ if .Timeouts.Connect }}proxy_connect_timeout {{ .Timeouts.Connect }};
        {{ end -}}
        {{ if .Timeouts.Read }}proxy_read_timeout {{ .Timeouts.Read }};
        {{ end -}}
        {{ if .Timeouts.Send }}proxy_send_timeout {{ .Timeouts.Send }};
        {{ end -}}
        {{ end -}}
        {{ if eq .AccessLogMode "off" }}access_log off;
        {{ else if eq .AccessLogMode "json" }}access_log {{ if .AccessLogFile }}{{ .AccessLogFile }}{{ else }}/var/log/nginx/access.log{{ end }} apigw_json;
        {{ else if eq .AccessLogMode "combined" }}access_log {{ if .AccessLogFile }}{{ .AccessLogFile }}{{ else }}/var/log/nginx/access.log{{ end }} combined;
        {{ else if .AccessLogFile }}access_log {{ .AccessLogFile }};
        {{ end -}}
        {{ if .RateLimitZone -}}
        limit_req zone=apigw_{{ .RateLimitZone }} burst={{ .RateLimitBurst }} nodelay;
        limit_req_status 429;
        {{ end -}}
        {{ if .CORS -}}
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $apigw_cors_origin always;
            add_header Access-Control-Allow-Methods "{{ .CORS.Methods }}" always;
            add_header Access-Control-Allow-Headers "{{ .CORS.Headers }}" always;
            {{ if .CORS.Credentials }}add_header Access-Control-Allow-Credentials "true" always;{{ end }}
            add_header Access-Control-Max-Age {{ .CORS.MaxAge }} always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $apigw_cors_origin always;
        {{ if .CORS.Credentials }}add_header Access-Control-Allow-Credentials "true" always;{{ end }}
        {{ end -}}
        {{ if .Mock -}}
        # Mock response — skip upstream entirely
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/mock/{{ .Name }};
        proxy_set_header Host $host;
        proxy_buffering off;
        {{ else if .GRPC -}}
        {{ if .UpstreamName }}grpc_pass grpc://{{ .UpstreamName }};
        {{ else }}grpc_pass grpc://127.0.0.1:{{ .Port }};
        {{ end -}}
        grpc_set_header Host               $host;
        grpc_set_header X-Real-IP          $remote_addr;
        grpc_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        grpc_set_header X-Forwarded-Proto  $scheme;
        {{ range $k, $v := .RequestHeaders -}}
        grpc_set_header {{ $k }} "{{ $v }}";
        {{ end -}}
        {{ else -}}
        {{ if .UpstreamName }}proxy_pass http://{{ .UpstreamName }};
        {{ else }}proxy_pass http://127.0.0.1:{{ .Port }};
        {{ end -}}
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        {{ range $k, $v := .RequestHeaders -}}
        proxy_set_header {{ $k }} "{{ $v }}";
        {{ end -}}
        {{ end -}}
        {{ range $k, $v := .ResponseHeaders -}}
        add_header {{ $k }} "{{ $v }}" always;
        {{ end -}}
        {{ range .ResponseHide -}}
        proxy_hide_header {{ . }};
        {{ end -}}
        {{ if .NextUpstream }}proxy_next_upstream {{ .NextUpstream }};
        proxy_next_upstream_tries {{ if .NextUpstreamTries }}{{ .NextUpstreamTries }}{{ else }}3{{ end }};
        {{ if .NextUpstreamTimeout }}proxy_next_upstream_timeout {{ .NextUpstreamTimeout }};
        {{ end -}}
        {{ end -}}
        proxy_read_timeout                 {{ if .ReadTimeout }}{{ .ReadTimeout }}{{ else }}300s{{ end }};
        proxy_send_timeout                 300s;
        {{ range .EarlyHints -}}
        add_header Link "{{ . }}" always;
        {{ end -}}
        {{ range .HTTP2Push -}}
        http2_push {{ . }};
        {{ end -}}
        proxy_buffering                    {{ if and .Buffering .Buffering.Response }}{{ .Buffering.Response }}{{ else }}off{{ end }};
        {{ if and .Buffering .Buffering.Request -}}
        proxy_request_buffering            {{ .Buffering.Request }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ClientBodyBufferSize -}}
        client_body_buffer_size            {{ .Buffering.ClientBodyBufferSize }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ProxyBufferSize -}}
        proxy_buffer_size                  {{ .Buffering.ProxyBufferSize }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ProxyBuffers -}}
        proxy_buffers                      {{ .Buffering.ProxyBuffers }};
        {{ end -}}
        {{ if .CustomLocation -}}
        # apigw custom_location ({{ .Name }}) — operator-supplied directives
        {{ .CustomLocation }}
        {{ end -}}
    }
    {{ if and .ForwardAuth .ForwardAuth.SignInURL -}}
    location @apigw_sign_in_{{ .Name }} {
        return 302 {{ .ForwardAuth.SignInURL }};
    }
    {{ end }}

    {{ end -}}
    {{ end -}}
    {{ range .Deploys -}}
    {{ if .Enabled -}}
    # deploy {{ .Name }} ({{ .Runtime }}, sha={{ .SHA }})
    {{ if eq .Runtime "static" -}}
    location {{ .Path }} {
        {{ if .LifecycleDraft -}}
        # lifecycle: draft — returns 503 until promoted to published.
        return 503 "draft API\n";
        {{ end -}}
        {{ if .LifecycleRetired -}}
        # lifecycle: retired — returns 410 Gone.
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        return 410 "retired API\n";
        {{ end -}}
        {{ if .LifecycleDeprecated -}}
        # lifecycle: deprecated — RFC 8594 Deprecation + Sunset headers.
        add_header Deprecation "true" always;
        {{ if .LifecycleSunsetAt -}}
        add_header Sunset "{{ .LifecycleSunsetAt }}" always;
        {{ end -}}
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        {{ end -}}
        {{ range .Rewrites -}}
        rewrite {{ .Match }} {{ .Replace }} {{ .Flag }};
        {{ end -}}
        {{ if .MaxBodySize }}client_max_body_size {{ .MaxBodySize }};
        {{ end -}}
        {{ range .Allow }}allow {{ . }};
        {{ end -}}
        {{ range .Deny }}deny {{ . }};
        {{ end -}}
        {{ if .Allow }}deny all;
        {{ end -}}
        {{ if .BasicAuthRealm -}}
        auth_basic "{{ .BasicAuthRealm }}";
        auth_basic_user_file {{ .BasicAuthFile }};
        {{ end -}}
        alias {{ .CurrentDir }}/;
        index index.html;
        try_files $uri $uri/ =404;
    }
    {{ else -}}
    {{ if .ForwardAuth -}}
    location = /{{ .ForwardAuth.UpstreamName }} {
        internal;
        proxy_pass {{ .ForwardAuth.Upstream }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {{ end -}}
    {{ if .JWT -}}
    location = /_apigw_jwt_{{ .Name }} {
        internal;
        proxy_pass http://127.0.0.1:{{ .JWTDashboardPort }}/auth/jwt/{{ .Name }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
    }
    {{ end -}}
    location {{ .Path }} {
        {{ if .LifecycleDraft -}}
        # lifecycle: draft — returns 503 until promoted to published.
        return 503 "draft API\n";
        {{ end -}}
        {{ if .LifecycleRetired -}}
        # lifecycle: retired — returns 410 Gone.
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        return 410 "retired API\n";
        {{ end -}}
        {{ if .LifecycleDeprecated -}}
        # lifecycle: deprecated — RFC 8594 Deprecation + Sunset headers.
        add_header Deprecation "true" always;
        {{ if .LifecycleSunsetAt -}}
        add_header Sunset "{{ .LifecycleSunsetAt }}" always;
        {{ end -}}
        {{ if .LifecycleReplacementURL -}}
        add_header Link "<{{ .LifecycleReplacementURL }}>; rel=\"successor-version\"" always;
        {{ end -}}
        {{ end -}}
        {{ range .Rewrites -}}
        rewrite {{ .Match }} {{ .Replace }} {{ .Flag }};
        {{ end -}}
        {{ if .MaxBodySize }}client_max_body_size {{ .MaxBodySize }};
        {{ end -}}
        {{ range .Allow }}allow {{ . }};
        {{ end -}}
        {{ range .Deny }}deny {{ . }};
        {{ end -}}
        {{ if .Allow }}deny all;
        {{ end -}}
        {{ if .BasicAuthRealm -}}
        auth_basic "{{ .BasicAuthRealm }}";
        auth_basic_user_file {{ .BasicAuthFile }};
        {{ end -}}
        {{ if .ForwardAuth -}}
        auth_request /{{ .ForwardAuth.UpstreamName }};
        {{ range .ForwardAuth.SetHeaders -}}
        auth_request_set ${{ . }} $upstream_http_{{ . }};
        proxy_set_header {{ . }} ${{ . }};
        {{ end -}}
        {{ if .ForwardAuth.SignInURL -}}
        error_page 401 = @apigw_sign_in_deploy_{{ .Name }};
        {{ end -}}
        {{ end -}}
        {{ if .JWT -}}
        auth_request /_apigw_jwt_{{ .Name }};
        auth_request_set $apigw_subject $upstream_http_x_apigw_subject;
        proxy_set_header X-Remote-User $apigw_subject;
        {{ end -}}
        {{ if .MTLS -}}
        auth_request /_apigw_mtls_{{ .Name }};
        auth_request_set $apigw_client_cn $upstream_http_x_apigw_client_cn;
        proxy_set_header X-Client-CN $apigw_client_cn;
        {{ end -}}
        {{ if .RateLimitZone -}}
        limit_req zone=apigw_{{ .RateLimitZone }} burst={{ .RateLimitBurst }} nodelay;
        limit_req_status 429;
        {{ end -}}
        {{ if .CORS -}}
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $apigw_cors_origin always;
            add_header Access-Control-Allow-Methods "{{ .CORS.Methods }}" always;
            add_header Access-Control-Allow-Headers "{{ .CORS.Headers }}" always;
            {{ if .CORS.Credentials }}add_header Access-Control-Allow-Credentials "true" always;{{ end }}
            add_header Access-Control-Max-Age {{ .CORS.MaxAge }} always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $apigw_cors_origin always;
        {{ if .CORS.Credentials }}add_header Access-Control-Allow-Credentials "true" always;{{ end }}
        {{ end -}}
        {{ if .UpstreamName }}proxy_pass http://{{ .UpstreamName }};
        {{ else }}proxy_pass http://127.0.0.1:{{ .Port }};
        {{ end -}}
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        {{ range $k, $v := .RequestHeaders -}}
        proxy_set_header {{ $k }} "{{ $v }}";
        {{ end -}}
        {{ range $k, $v := .ResponseHeaders -}}
        add_header {{ $k }} "{{ $v }}" always;
        {{ end -}}
        {{ range .ResponseHide -}}
        proxy_hide_header {{ . }};
        {{ end -}}
        {{ if .NextUpstream }}proxy_next_upstream {{ .NextUpstream }};
        proxy_next_upstream_tries {{ if .NextUpstreamTries }}{{ .NextUpstreamTries }}{{ else }}3{{ end }};
        {{ if .NextUpstreamTimeout }}proxy_next_upstream_timeout {{ .NextUpstreamTimeout }};
        {{ end -}}
        {{ end -}}
        proxy_read_timeout                 {{ if .ReadTimeout }}{{ .ReadTimeout }}{{ else }}300s{{ end }};
        proxy_send_timeout                 300s;
        {{ range .EarlyHints -}}
        add_header Link "{{ . }}" always;
        {{ end -}}
        {{ range .HTTP2Push -}}
        http2_push {{ . }};
        {{ end -}}
        proxy_buffering                    {{ if and .Buffering .Buffering.Response }}{{ .Buffering.Response }}{{ else }}off{{ end }};
        {{ if and .Buffering .Buffering.Request -}}
        proxy_request_buffering            {{ .Buffering.Request }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ClientBodyBufferSize -}}
        client_body_buffer_size            {{ .Buffering.ClientBodyBufferSize }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ProxyBufferSize -}}
        proxy_buffer_size                  {{ .Buffering.ProxyBufferSize }};
        {{ end -}}
        {{ if and .Buffering .Buffering.ProxyBuffers -}}
        proxy_buffers                      {{ .Buffering.ProxyBuffers }};
        {{ end -}}
        {{ if .CustomLocation -}}
        # apigw custom_location ({{ .Name }}) — operator-supplied directives
        {{ .CustomLocation }}
        {{ end -}}
    }
    {{ if and .ForwardAuth .ForwardAuth.SignInURL -}}
    location @apigw_sign_in_deploy_{{ .Name }} {
        return 302 {{ .ForwardAuth.SignInURL }};
    }
    {{ end -}}
    {{ end }}

    {{ end -}}
    {{ end -}}
    {{ if .Webhook.Enabled -}}
    location {{ .Webhook.Path }} {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:{{ .Webhook.Port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    }

    {{ end -}}
    {{ if .Dashboard.Enabled -}}
    # Dashboard mount. EVERYTHING dashboard-related (HTML, app.css,
    # app.js, favicon, /api/admin/*, /api/status, /events SSE) lives under
    # {{ .Dashboard.Path }}/ on the gateway. We rewrite the prefix away and
    # the daemon serves itself as if mounted at root.
    #
    # Why this shape (versus exposing /api/admin/* at gateway root):
    # the gateway namespace at root is owned by user-defined APIs
    # (e.g. /api/foodmanager). Leaking dashboard admin routes
    # alongside them creates collisions when a user names an API
    # "admin" or "status" or "logs", and makes the security boundary
    # fuzzy — at a glance you cannot tell which /api/<X> is the
    # operator API and which is a user-facing service. Confining the
    # whole dashboard to a single prefix solves both.
    #
    # `<base href="{{ .Dashboard.Path }}/">` in index.html pins every
    # relative URL in HTML + JS (`fetch("api/admin/audit")` etc.) to
    # this mount, so the same dashboard daemon works behind any
    # Dashboard.Path operators choose.
    location = {{ .Dashboard.Path }} {
        return 301 {{ .Dashboard.Path }}/;
    }
    location {{ .Dashboard.Path }}/ {
        rewrite ^{{ .Dashboard.Path }}/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:{{ .Dashboard.Port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_buffering off;                    # SSE — never buffer
        proxy_set_header X-Accel-Buffering no;  # SSE — never buffer
    }
    {{ end -}}
    location / {
        {{ if .RootRedirect }}return 301 {{ .RootRedirect }};{{ else }}return 404;{{ end }}
    }
{{- end }}
